{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "EmployeeApi": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Diagnostics.HealthChecks": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss.fff zzz "
      }
    }
  },
  "AllowedHosts": "*",
  "EnableSwaggerInProduction": true
}
